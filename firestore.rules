rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: one document per student account.
    // Fields: firstName, lastName, quarter, group, email, schoolId,
    //         role, emailVerified, diagnosticCompleted, createdAt, lastLogin
    match /users/{uid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      function institutional() { return request.auth.token.email.matches('.*@upsrj[.]edu[.]mx$'); }

      allow read: if isOwner();

      allow create: if isOwner()
        && institutional()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolId == request.auth.token.email.split('@')[0]
        && request.resource.data.role == 'student'
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName  is string && request.resource.data.lastName.size()  > 0
        && request.resource.data.group     is string && request.resource.data.group.size()     > 0
        && request.resource.data.quarter   is int    && request.resource.data.quarter >= 1 && request.resource.data.quarter <= 10;

      // Students may only update these fields of their own document.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['emailVerified', 'lastLogin', 'diagnosticCompleted']);

      allow delete: if false;
    }
  }
}
