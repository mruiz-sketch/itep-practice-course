rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function institutional() { return request.auth.token.email.matches('.*@upsrj[.]edu[.]mx$'); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    // A teacher sees students only after the administrator sets approved = true
    // on the teacher's document (Firebase console > Firestore > users).
    function isApprovedTeacher() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'teacher' && me().approved == true;
    }

    // NOTE: the real teachers code is set only in the Firebase console (this repo is public).
    // users/{uid}: one document per account (role: 'student' or 'teacher').
    match /users/{uid} {
      function isOwner() { return signedIn() && request.auth.uid == uid; }
      function d() { return request.resource.data; }
      function baseOk() {
        return isOwner() && institutional()
          && d().email == request.auth.token.email
          && d().schoolId == request.auth.token.email.split('@')[0]
          && d().firstName is string && d().firstName.size() > 0
          && d().lastName is string && d().lastName.size() > 0;
      }

      allow read: if isOwner() || (isApprovedTeacher() && resource.data.role == 'student');

      allow create: if baseOk() && (
        (d().role == 'student'
          && d().group is string && d().group.size() > 0
          && d().quarter is int && d().quarter >= 0 && d().quarter <= 9)
        || (d().role == 'teacher' && d().approved == false && d().teacherCode == 'TEACHER_CODE_HERE')
      );

      allow update: if isOwner() && (
        (resource.data.role == 'student'
          && d().diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'lastLogin']))
        // the diagnostic result can be saved only once
        || (resource.data.role == 'student' && resource.data.diagnosticCompleted == false
          && d().diagnosticCompleted == true
          && d().diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'lastLogin', 'diagnosticCompleted',
               'diagnosticLevel', 'diagnosticScore', 'diagnosticSections', 'diagnosticPractice',
               'diagnosticCorrect', 'diagnosticTotal', 'diagnosticAt']))
        // learning path progress (only after the diagnostic)
        || (resource.data.role == 'student' && resource.data.diagnosticCompleted == true
          && d().diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'lastLogin', 'pathProgress', 'pathDone', 'pathTotal', 'pathUpdatedAt'])
          && (!('pathDone' in d()) || d().pathDone is int) && (!('pathTotal' in d()) || d().pathTotal is int))
        || (resource.data.role == 'teacher'
          && d().diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'lastLogin', 'quarters', 'groups', 'setupComplete']))
      );

      allow delete: if false;
    }
  }
}
