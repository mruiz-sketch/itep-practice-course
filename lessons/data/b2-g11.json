   ]
  },
  {
   "type": "explain",
   "title": "Verb patterns",
   "table": {
    "head": [
     "Pattern",
     "Verbs",
     "Example"
    ],
    "rows": [
     [
      "+ to + verb",
      "agree, offer, promise, refuse, threaten",
      "He **refused to** sign."
     ],
     [
      "+ person + to",
      "advise, encourage, persuade, remind, warn",
      "She **reminded me to** call."
     ],
     [
      "+ -ing",
      "admit, deny, recommend, suggest",
      "He **denied stealing** the money."
     ],
     [
      "+ preposition + -ing",
      "apologize for, accuse sb of, insist on",
      "She **apologized for being** late."
     ],
     [
      "+ that",
      "explain, claim, complain, admit",
      "They **claimed that** it was safe."
     ]
    ]
   }
  },
