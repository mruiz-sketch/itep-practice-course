        { "t": "I am from Spain. → I ___ from Spain.", "a": ["'m not", "am not", "m not"], "clue": "Recuerda: *amn't* no existe." },
        { "t": "It is expensive. → It ___ expensive.", "a": ["isn't", "is not", "'s not"] }
      ]
    },
    {
      "type": "listen",
      "title": "Escucha y elige lo que oíste",
      "items": [
