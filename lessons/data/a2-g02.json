  {
   "type": "explain",
   "title": "Regulares: -ed",
   "table": {
    "head": [
     "Regla",
     "Ejemplo"
    ],
    "rows": [
     [
      "La mayoría: **+ ed**",
      "work → worked, play → played"
     ],
     [
      "Termina en -e: **+ d**",
      "live → lived, dance → danced"
     ],
     [
      "Consonante + y: **y → ied**",
      "study → studied, try → tried"
     ],
     [
      "C-V-C corta: **dobla**",
      "stop → stopped, plan → planned"
     ]
    ]
   },
   "tip": "El pasado es igual para todas las personas: *I worked, she worked, they worked*."
  },
