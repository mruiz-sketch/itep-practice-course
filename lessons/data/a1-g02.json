        { "q": "**Carlos and I** are brothers.", "options": ["They", "You", "We"], "a": 2, "why": "*Carlos and I* incluye a quien habla → **we**." },
        { "q": "**My parents** are at home.", "options": ["They", "We", "He"], "a": 0 },
        { "q": "**You and Juan** are late.", "options": ["They", "You", "We"], "a": 1, "why": "*You and Juan* = ustedes → **you**." },
        { "q": "**The computers** are new.", "options": ["It", "They", "She"], "a": 1, "why": "Varias cosas → **they**." }
