  "slides": [
    {
      "type": "cover",
      "title": "I, you, he, she, it, we, they",
      "subtitle": "Pronombres personales sujeto",
      "goals": [
        "Elegir el pronombre correcto para personas, animales y cosas.",
        "Recordar que en inglés **el sujeto nunca se omite**.",
        "Usar **it** para el clima, la hora y las cosas."
      ]
    },
    {
      "type": "explain",
      "title": "Los siete pronombres sujeto",
      "body": [
        "El pronombre sujeto indica **quién** hace la acción. Va siempre antes del verbo."
      ],
      "table": {
        "head": ["Inglés", "Español", "Se usa para"],
        "rows": [
          ["**I**", "yo", "Siempre con mayúscula, incluso a mitad de oración."],
          ["**you**", "tú / usted / ustedes", "Singular y plural, formal e informal."],
          ["**he**", "él", "Un hombre o un niño."],
          ["**she**", "ella", "Una mujer o una niña."],
          ["**it**", "(no se traduce)", "Cosas, animales, el clima y la hora."],
          ["**we**", "nosotros / nosotras", "Yo + otras personas."],
          ["**they**", "ellos / ellas", "Varias personas o cosas. También una persona cuyo género no se especifica."]
        ],
        "speak": 0,
        "say": ["I", "you", "he", "she", "it", "we", "they"]
      },
      "errors": [
        { "bad": "Is a student.", "good": "**She** is a student.", "note": "En español decimos *Es estudiante*, pero en inglés el sujeto es obligatorio." },
        { "bad": "Is raining.", "good": "**It** is raining.", "note": "Para el clima y la hora se usa **it**: *It's 3 o'clock*." }
      ]
    },
    {
      "type": "examples",
      "title": "Pronombres en contexto",
      "items": [
        { "en": "**I** am from Querétaro.", "es": "Soy de Querétaro." },
        { "en": "**You** are my friends.", "es": "Ustedes son mis amigos.", "note": "*You* también es plural." },
        { "en": "This is Luis. **He** is a teacher.", "es": "Él es Luis. Es maestro." },
        { "en": "My mom is 50. **She** is a nurse.", "es": "Mi mamá tiene 50. Es enfermera." },
        { "en": "Look at the dog. **It** is very big.", "es": "Mira al perro. Es muy grande." },
        { "en": "**It** is cold today.", "es": "Hace frío hoy.", "note": "Clima → **it**." },
        { "en": "Ana and I are classmates. **We** are in 1A.", "es": "Ana y yo somos compañeras. Estamos en 1A." },
        { "en": "The students are here. **They** are early.", "es": "Los alumnos están aquí. Llegaron temprano." }
      ]
    },
    {
      "type": "mc",
      "title": "Cambia el sustantivo por un pronombre",
      "items": [
