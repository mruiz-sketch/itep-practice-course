    "rows": [
     [
      "Preposition + whom / which",
      "The person **to whom** I spoke…",
      "The person I spoke **to**…"
     ],
     [
      "Quantifier + of whom / which",
      "I have two brothers, **both of whom** live abroad.",
      ""
