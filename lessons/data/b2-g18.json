   "type": "explain",
   "title": "Two types",
   "table": {
    "head": [
     "Type",
     "Neutral",
     "Cleft"
    ],
    "rows": [
     [
      "It-cleft",
      "Ana broke the vase.",
      "**It was Ana who** broke the vase."
     ],
     [
      "It-cleft (time)",
      "I met him in 2019.",
      "**It was in 2019 that** I met him."
     ],
     [
      "Wh-cleft",
      "I need a holiday.",
      "**What I need is** a holiday."
     ],
     [
      "All-cleft",
      "I want some peace.",
      "**All I want is** some peace."
     ]
    ]
   }
