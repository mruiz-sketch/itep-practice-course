 "slides": [
  {
   "type": "cover",
   "title": "So / such, too / enough",
   "subtitle": "Intensifying and expressing degree",
   "goals": [
    "Use **so + adjective** and **such (a) + noun**.",
    "Express excess with **too** and sufficiency with **enough**.",
    "Add results with **that**."
   ]
  },
  {
   "type": "explain",
   "title": "Rules",
   "table": {
    "head": [
     "Structure",
     "Example"
    ],
    "rows": [
     [
      "so + adjective / adverb",
      "It was **so cold** that we stayed in."
     ],
     [
      "such (a) + (adj) + noun",
      "It was **such a cold day**. / They are **such nice people**."
     ],
     [
      "too + adjective (+ to)",
      "He's **too young to** drive."
     ],
     [
      "adjective + enough (+ to)",
      "She's **old enough to** vote."
     ],
     [
      "enough + noun",
      "We don't have **enough time**."
     ]
    ]
   },
   "watch": "**enough** goes *after* adjectives but *before* nouns."
  },
  {
   "type": "mc",
