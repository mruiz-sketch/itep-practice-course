          ["Afirmativo", "verbo base", "**Open** your books. **Listen**."],
          ["Negativo", "**Don't** + verbo", "**Don't run**. **Don't be** late."],
          ["Sugerencia", "**Let's** + verbo", "**Let's go**! **Let's start**."],
          ["Cortés", "**Please** + imperativo", "**Please** sit down. / Sit down, **please**."]
        ]
      },
      "tip": "El imperativo es igual para *tú* y para *ustedes*: *Come here* sirve para una persona o para un grupo.",
