        { "w": "dish", "b": 1 }, { "w": "glass", "b": 1 }, { "w": "potato", "b": 1 },
        { "w": "party", "b": 2 }, { "w": "family", "b": 2 }, { "w": "story", "b": 2 }
      ]
    },
    {
      "type": "match",
      "title": "Relaciona singular y plural irregular",
      "pairs": [["man", "men"], ["foot", "feet"], ["person", "people"], ["mouse", "mice"], ["tooth", "teeth"], ["sheep", "sheep"]],
      "speak": "right"
    },
    {
      "type": "mc",
      "title": "Encuentra la forma correcta",
      "items": [
