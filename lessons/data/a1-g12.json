        { "en": "Why do you study English? — Because I want to travel.", "es": "¿Por qué estudias inglés? — Porque quiero viajar." },
        { "en": "How much is this T-shirt? — It's 200 pesos.", "es": "¿Cuánto cuesta esta playera? — 200 pesos." },
        { "en": "How many students are there? — Twenty-eight.", "es": "¿Cuántos alumnos hay? — Veintiocho." },
        { "en": "What time does the class finish? — At two.", "es": "¿A qué hora termina la clase? — A las dos." }
