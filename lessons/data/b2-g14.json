   "table": {
    "head": [
     "Function",
     "Linker",
     "Example"
    ],
    "rows": [
     [
      "Contrast (two facts)",
      "whereas / while",
      "I love tea, **whereas** my sister prefers coffee."
     ],
     [
      "Contrast (formal, new sentence)",
      "Nevertheless, / Nonetheless,",
      "It was risky. **Nevertheless**, they continued."
     ],
     [
      "Concession + noun / -ing",
      "in spite of / despite",
      "**Despite having** little money, they traveled."
     ],
     [
      "Purpose",
      "so as to / in order to",
      "I left early **so as to** avoid traffic."
     ],
     [
      "Negative purpose",
      "so as not to / in order not to",
      "He whispered **so as not to** wake the baby."
     ],
     [
      "Purpose + clause",
      "so that",
      "I saved money **so that** I could travel."
     ]
    ]
   }
